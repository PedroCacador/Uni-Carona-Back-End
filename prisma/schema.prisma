generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                  String        @id @default(uuid())
  nome                String
  senha               String
  email               String        @unique
  cpf                 String        @unique
  matricula           String?
  curso               String
  status              StatusUsuario
  dataNascimento      DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  role                Role          @default(USER)
  resetPasswordToken  String?
  resetPasswordExpires DateTime?

  @@index([resetPasswordToken])
  avaliacoesRecebidas Avaliacao[]   @relation("Avaliado")
  avaliacoesFeitas    Avaliacao[]   @relation("Avaliador")
  caronas             Carona[]
  reservas            Reserva[]
  veiculos            Veiculo[]
}

model Veiculo {
  id             String   @id @default(uuid())
  placa          String   @unique
  marca          String
  modelo         String
  cor            String
  proprietarioId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  caronas        Carona[]
  proprietario   Usuario  @relation(fields: [proprietarioId], references: [id])
}

model Carona {
  id                  String       @id @default(uuid())
  origem              String
  latitudeOrigem      Float?
  longitudeOrigem     Float?
  destino             String
  latitudeDestino     Float?
  longitudeDestino    Float?
  rotaPolyline        String?
  distanciaMetros     Int?
  duracaoSegundos     Int?
  dataHoraSaida       DateTime
  assentosDisponiveis Int
  valorAjuda          Decimal?
  status              StatusCarona
  motoristaId         String
  veiculoId           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  avaliacaos          Avaliacao[]
  motorista           Usuario      @relation(fields: [motoristaId], references: [id])
  veiculo             Veiculo      @relation(fields: [veiculoId], references: [id])
  reservas            Reserva[]
}

model Reserva {
  id                String        @id @default(uuid())
  status            StatusReserva
  quantidadePessoas Int
  caronaId          String
  usuarioId         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  carona            Carona        @relation(fields: [caronaId], references: [id])
  passageiro        Usuario       @relation(fields: [usuarioId], references: [id])

  @@unique([caronaId, usuarioId])
}

model Avaliacao {
  id          String   @id @default(uuid())
  caronaId    String
  avaliadorId String
  avaliadoId  String
  nota        Int
  comentario  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  avaliado    Usuario  @relation("Avaliado", fields: [avaliadoId], references: [id])
  avaliador   Usuario  @relation("Avaliador", fields: [avaliadorId], references: [id])
  carona      Carona   @relation(fields: [caronaId], references: [id])

  @@unique([caronaId, avaliadorId, avaliadoId])
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

enum Role {
  USER
  ADMIN
}

enum StatusCarona {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum StatusReserva {
  PENDENTE
  CONFIRMADA
  CANCELADA
}
