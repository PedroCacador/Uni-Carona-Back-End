# Ambiente: development (MockEmailService) | production (ResendEmailService)
NODE_ENV=development

# Servidor HTTP (padrão: 3333)
PORT=3333

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unicarona?schema=public

# Autenticação JWT (obrigatório)
# Gere com: openssl rand -base64 32
JWT_SECRET=substitua_por_um_segredo_forte_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=1d

# Recuperação de senha
RESET_PASSWORD_EXPIRES_MINUTES=15

# Resend (obrigatório apenas quando NODE_ENV=production)
# API Key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=UniCarona <onboarding@resend.dev>

# Maps (opcional)
# MAPS_API_KEY=
