# Servidor HTTP (padrão: 3333)
PORT=3333

# PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unicarona?schema=public

# Autenticação JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Recuperação de senha
RESET_PASSWORD_EXPIRES_MINUTES=15
FRONTEND_URL=http://localhost:3000

# E-mail (integração futura — MockEmailService em desenvolvimento)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Maps / geocoding (OpenStreetMap Nominatim — sem chave obrigatória)
# MAPS_API_KEY=
