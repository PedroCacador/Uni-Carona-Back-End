{
  "name": "unicarona-back-end",
  "version": "1.0.0",
  "description": "API REST do UniCarona — sistema de caronas universitárias",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:auth": "jest src/services/AuthService.spec.ts src/services/AuthService.integration.spec.ts src/controllers/AuthController.spec.ts src/utils/EmailValidator.spec.ts src/utils/ResetTokenHelper.spec.ts src/utils/UsuarioSanitizer.spec.ts src/utils/PayloadValidator.spec.ts",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "script:create-caronas": "npx ts-node scripts/create-caronas.ts"
  },
  "keywords": ["carona", "universidade", "express", "typescript", "prisma"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.3.0",
    "prisma": "^7.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
